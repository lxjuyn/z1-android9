# Exact factory 3.4.67: legacy USB, built-in drivers; no mainline modules.
on fs
    exec u:r:init:s0 root root -- /z1_bootdiag --stock-partitions
    mount_all /fstab.z1

on init
    setprop sys.z1.stock_mount_ready 0
    setprop sys.z1.wmt_nodes_ready 0
    setprop sys.usb.configfs 0
    setprop sys.usb.config acm
    setprop sys.usb.state acm

on post-fs
    # This static ramdisk executable does not require /system/bin/sh.
    # A failed check never publishes readiness; keep later startup blocked.
    exec u:r:init:s0 root root -- /z1_stock_mount_guard
    wait_for_prop sys.z1.stock_mount_ready 1
    # Original 3.4.67 WMT driver uses fixed MTK character-device numbers.
    exec u:r:init:s0 root root -- /system/bin/sh -c "if [ ! -c /dev/wmtWifi ]; then /system/bin/mknod -m 0660 /dev/wmtWifi c 153 0; fi"
    chmod 0660 /dev/wmtWifi
    chown system system /dev/wmtWifi
    exec u:r:init:s0 root root -- /system/bin/sh -c "if [ ! -c /dev/stpwmt ]; then /system/bin/mknod -m 0660 /dev/stpwmt c 190 0; fi"
    chmod 0660 /dev/stpwmt
    chown system system /dev/stpwmt
    exec u:r:init:s0 root root -- /system/bin/sh -c "if [ ! -c /dev/stpbt ]; then /system/bin/mknod -m 0660 /dev/stpbt c 192 0; fi"
    chmod 0660 /dev/stpbt
    chown bluetooth radio /dev/stpbt
    setprop sys.z1.wmt_nodes_ready 1
    mkdir /data/nvram 2770 root nvram
    exec_background u:r:init:s0 root root -- /z1_bootdiag

# Match the factory 3.4.67 WLAN driver's function-on/off control. The
# readiness condition retries an early property transition after node setup;
# the character-device test prevents a missing node becoming a regular file.
on property:wlan.driver.status=ok && property:sys.z1.wmt_nodes_ready=1
    exec u:r:init:s0 root root -- /system/bin/sh -c "if [ -c /dev/wmtWifi ]; then printf 1 > /dev/wmtWifi; fi"

on property:wlan.driver.status=unloaded && property:sys.z1.wmt_nodes_ready=1
    exec u:r:init:s0 root root -- /system/bin/sh -c "if [ -c /dev/wmtWifi ]; then printf 0 > /dev/wmtWifi; fi"

on post-fs-data
    # Preserve the device's own radio calibration. Create only its directory;
    # never package NVRAM contents in the image or repository.
    mkdir /data/nvram/bt 2771 bluetooth bluetooth
    swapon_all /fstab.z1
    start z1_logcat_relay
    # Create the missing VT alias, request graphics mode, then detach fbcon.
    # The serial console remains active for kernel and Android log capture.
    exec u:r:init:s0 root root -- /system/bin/sh /z1_display_takeover.sh

service z1_logcat_relay /z1_bootdiag --logcat
    class core
    user root
    group log
    disabled
    seclabel u:r:init:s0

# The exact Z1 3.4.67 kernel contains MTK's built-in WMT/WLAN/BTIF drivers.
# These factory userspace helpers load generic radio firmware; they do not
# include or replace this device's private NVRAM calibration.
service conn_launcher /system/bin/6620_launcher -p /system/etc/firmware/
    class core
    user system
    group system
    seclabel u:r:init:s0

service wmtLoader /system/bin/wmt_loader
    class main
    user root
    group root
    oneshot
    seclabel u:r:init:s0
