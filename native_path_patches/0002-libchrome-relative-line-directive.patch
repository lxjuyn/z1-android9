+    marker = 'external/libchrome/'
+    marker_index = path.rfind(marker)
+    if marker_index >= 0:
+        path = path[marker_index:]
+    elif path.startswith('/'):
+        path = path.rsplit('/', 1)[-1]
+    return path.replace('\\', '\\\\').replace('"', '\\"')
