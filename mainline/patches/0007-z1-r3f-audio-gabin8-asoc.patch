+		regmap_write(priv->regmap, AUDTOP_CON(6), 0xb7f6);
+		/* enable clean 1.35VCM buffer in audioUL */
+		regmap_update_bits(priv->regmap, AUDTOP_CON(0), 0x7000, 0xf000);
+		/* enable audio bias. enable LCH DAC */
