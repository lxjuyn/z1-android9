static int32_t z1_set_client_target(hwc2_device_t *d, hwc2_display_t display,
				    buffer_handle_t target, int32_t acquire_fence,
				    int32_t /*dataspace*/, hwc_region_t damage)
{
	z1_hwc2 *h = H(d);

	(void)display; (void)damage;
	h->client_target = target;
	h->client_acquire_fence = acquire_fence;
	return HWC2_ERROR_NONE;
}

static int32_t z1_validate_display(hwc2_device_t *d, hwc2_display_t display,
				   uint32_t *num_types, uint32_t *num_requests)
{
	z1_hwc2 *h = H(d);

	(void)display;
	h->changed.clear();
	clear_planes(h);

	/* Sort layers bottom-to-top by z. */
	std::vector<z1_layer *> order;
	for (auto &kv : h->layers)
		order.push_back(&kv.second);
	for (size_t i = 0; i + 1 < order.size(); i++)
		for (size_t j = 0; j + 1 < order.size() - i; j++)
			if (order[j]->z > order[j + 1]->z) {
				z1_layer *t = order[j];
				order[j] = order[j + 1];
				order[j + 1] = t;
			}

	/* Bottom plane is reserved for the client target. */
	if (h->plane_count > 0)
		h->planes[0].in_use = true;

	for (z1_layer *l : order) {
		hwc2_composition_t want = l->composition;

		if (want == HWC2_COMPOSITION_INVALID)
			want = HWC2_COMPOSITION_DEVICE;

		if (want == HWC2_COMPOSITION_DEVICE ||
		    want == HWC2_COMPOSITION_CURSOR) {
			bool ok = l->have_buffer && l->transform == (hwc_transform_t)0;
			hwc_rect_t f = l->frame;
			hwc_frect_t c = l->crop;

			if (ok) {
				int w = (int)(c.right - c.left);
				int hh = (int)(c.bottom - c.top);
				if (w != (f.right - f.left) || hh != (f.bottom - f.top))
					ok = false;	/* scaling not supported */
				if (f.left < 0 || f.top < 0 ||
				    f.right > (int)h->width || f.bottom > (int)h->height)
					ok = false;
			}
			if (ok)
				ok = import_layer(h, l) == 0;
			if (ok && find_free_plane(h) < 0)
				ok = false;

			if (!ok) {
				l->composition = HWC2_COMPOSITION_CLIENT;
				h->changed.push_back(l->id);
			} else {
				l->composition = want;
				int p = find_free_plane(h);
				if (p >= 0)
					h->planes[p].in_use = true;
			}
		} else if (want == HWC2_COMPOSITION_CLIENT) {
			/* already client, nothing to report */
		} else {
			l->composition = HWC2_COMPOSITION_CLIENT;
			h->changed.push_back(l->id);
		}
	}

	h->validated = true;
	*num_types = (uint32_t)h->changed.size();
	*num_requests = 0;
	return HWC2_ERROR_NONE;
}

static int32_t z1_get_changed_composition_types(hwc2_device_t *d, hwc2_display_t display,
						uint32_t *num_elements,
						hwc2_layer_t *layers, int32_t *types)
{
	z1_hwc2 *h = H(d);

	(void)display;
	for (size_t i = 0; i < h->changed.size(); i++) {
		layers[i] = h->changed[i];
		types[i] = HWC2_COMPOSITION_CLIENT;
	}
	*num_elements = (uint32_t)h->changed.size();
	return HWC2_ERROR_NONE;
}

