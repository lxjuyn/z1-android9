	*out_requests = 0;
	*out_num = 0;
	return HWC2_ERROR_NONE;
}

/* ------------------------------------------------------------- present --- */

static int program_plane(z1_hwc2 *h, drmModeAtomicReq *req, int idx,
			 uint32_t fb_id, bool have_fb, hwc_rect_t frame,
			 hwc_frect_t crop, int max_w, int max_h)
{
	z1_plane *p = &h->planes[idx];

	if (!have_fb) {
		drmModeAtomicAddProperty(req, p->id, p->p_fb, 0);
		drmModeAtomicAddProperty(req, p->id, p->p_crtc, 0);
		return 0;
	}

	if ((crop.right - crop.left) <= 0.0f || (crop.bottom - crop.top) <= 0.0f) {
		klog("z1hwc2: empty crop, using full frame\n");
		crop.left = 0.0f;
		crop.top = 0.0f;
		crop.right = (float)(frame.right - frame.left);
		crop.bottom = (float)(frame.bottom - frame.top);
	}

	int w = frame.right - frame.left;
	int hh = frame.bottom - frame.top;
	if (w <= 0 || hh <= 0)
		return -1;
	if (w > max_w) w = max_w;
	if (hh > max_h) hh = max_h;

	/* SRC_* are 16.16 fixed point */
	drmModeAtomicAddProperty(req, p->id, p->p_fb, fb_id);
	drmModeAtomicAddProperty(req, p->id, p->p_crtc, h->crtc_id);
	drmModeAtomicAddProperty(req, p->id, p->p_cx, frame.left);
	drmModeAtomicAddProperty(req, p->id, p->p_cy, frame.top);
	drmModeAtomicAddProperty(req, p->id, p->p_cw, w);
	drmModeAtomicAddProperty(req, p->id, p->p_ch, hh);
	drmModeAtomicAddProperty(req, p->id, p->p_sx, (uint32_t)(crop.left * 65536.0f));
	drmModeAtomicAddProperty(req, p->id, p->p_sy, (uint32_t)(crop.top * 65536.0f));
	drmModeAtomicAddProperty(req, p->id, p->p_sw, (uint32_t)((crop.right - crop.left) * 65536.0f));
	drmModeAtomicAddProperty(req, p->id, p->p_sh, (uint32_t)((crop.bottom - crop.top) * 65536.0f));
	return 0;
}

static int32_t z1_present_display(hwc2_device_t *d, hwc2_display_t display,
				  int32_t *retire_fence)
{
	z1_hwc2 *h = H(d);
	drmModeAtomicReq *req;
	uint32_t flags = DRM_MODE_ATOMIC_NONBLOCK;

	(void)display;
	*retire_fence = -1;

	if (!h->powered_on)
		return HWC2_ERROR_NONE;

	req = drmModeAtomicAlloc();
	if (!req)
		return HWC2_ERROR_NO_RESOURCES;

	if (!h->mode_set_done) {
		uint32_t blob = 0;

		if (drmModeCreatePropertyBlob(h->drm_fd, &h->mode,
					      sizeof(h->mode), &blob))
			ALOGE("create mode blob failed: %s", strerror(errno));
		h->mode_blob = blob;
		drmModeAtomicAddProperty(req, h->connector_id,
					 h->connector_crtc_prop, h->crtc_id);
		drmModeAtomicAddProperty(req, h->crtc_id, h->crtc_mode_prop, blob);
		drmModeAtomicAddProperty(req, h->crtc_id, h->crtc_active_prop, 1);
		flags |= DRM_MODE_ATOMIC_ALLOW_MODESET;
	}

	/* plane 0: client target (bottom). planes 1..n: DEVICE layers */
	int slot = 0;
	hwc_rect_t full = { 0, 0, (int)h->width, (int)h->height };
	hwc_frect_t fullc = { 0.0f, 0.0f, (float)h->width, (float)h->height };

	if (h->client_target) {
		if (h->client_target != h->client_handle) {
			if (h->client_fb) {
				drmModeRmFB(h->drm_fd, h->client_fb);
				drmCloseBufferHandle(h->drm_fd, h->client_gem);
				h->client_fb = 0;
				h->client_gem = 0;
			}
			h->client_handle = h->client_target;
			z1_layer tmp;

			tmp.handle = h->client_target;
			if (import_layer(h, &tmp) == 0) {
				h->client_fb = tmp.fb_id;
				h->client_gem = tmp.gem;
			}
		}
		if (h->client_fb && slot < h->plane_count &&
		    program_plane(h, req, slot, h->client_fb, true, full, fullc,
				  h->width, h->height) == 0)
			slot++;
	}

	/* device layers, bottom to top */
	std::vector<z1_layer *> order;
	for (auto &kv : h->layers)
		order.push_back(&kv.second);
	for (size_t i = 0; i + 1 < order.size(); i++)
		for (size_t j = 0; j + 1 < order.size() - i; j++)
			if (order[j]->z > order[j + 1]->z) {
				z1_layer *t = order[j];
				order[j] = order[j + 1];
				order[j + 1] = t;
			}

	for (z1_layer *l : order) {
		if (l->composition != HWC2_COMPOSITION_DEVICE &&
		    l->composition != HWC2_COMPOSITION_CURSOR)
			continue;
		if (!l->fb_id)
			continue;
		if (slot >= h->plane_count)
			break;
		if (program_plane(h, req, slot, l->fb_id, true, l->frame, l->crop,
				  h->width, h->height) == 0)
			slot++;
	}
	for (int i = slot; i < h->plane_count; i++)
		program_plane(h, req, i, 0, false, full, fullc, 0, 0);

	int rc = drmModeAtomicCommit(h->drm_fd, req, flags, h);
	if (rc) {
		ALOGE("atomic commit failed: %s", strerror(errno));
		drmModeAtomicFree(req);
		return HWC2_ERROR_NO_RESOURCES;
	}
	drmModeAtomicFree(req);

	if (!h->mode_set_done) {
		h->mode_set_done = true;
		ALOGI("first commit done: %ux%u", h->width, h->height);
	}

	/* release fences: buffers are consumed synchronously here */
	for (auto &kv : h->layers) {
		if (kv.second.acquire_fence >= 0) {
			close(kv.second.acquire_fence);
			kv.second.acquire_fence = -1;
		}
		h->release_fences[kv.first] = -1;
	}
	if (h->client_acquire_fence >= 0) {
		close(h->client_acquire_fence);
		h->client_acquire_fence = -1;
	}
	return HWC2_ERROR_NONE;
}

static int32_t z1_get_release_fences(hwc2_device_t *d, hwc2_display_t display,
				     uint32_t *num_elements, hwc2_layer_t *layers,
				     int32_t *fences)
{
	z1_hwc2 *h = H(d);
	uint32_t n = 0;

	(void)display;
	for (auto &kv : h->release_fences) {
		layers[n] = kv.first;
		fences[n] = kv.second;
		n++;
	}
	h->release_fences.clear();
	*num_elements = n;
	return HWC2_ERROR_NONE;
}

/* --------------------------------------------------------- display info --- */

static int32_t z1_get_display_attribute(hwc2_device_t *d, hwc2_display_t display,
					int32_t /*config*/, int32_t attribute,
					int32_t *out_value)
{
	z1_hwc2 *h = H(d);

	(void)display;
	switch (attribute) {
	case HWC2_ATTRIBUTE_WIDTH: *out_value = (int32_t)h->width; return HWC2_ERROR_NONE;
	case HWC2_ATTRIBUTE_HEIGHT: *out_value = (int32_t)h->height; return HWC2_ERROR_NONE;
	case HWC2_ATTRIBUTE_VSYNC_PERIOD:
		*out_value = h->mode.vrefresh ? 1000000000 / h->mode.vrefresh : 16666667;
		return HWC2_ERROR_NONE;
	case HWC2_ATTRIBUTE_DPI_X: *out_value = 160 * 1000; return HWC2_ERROR_NONE;
	case HWC2_ATTRIBUTE_DPI_Y: *out_value = 160 * 1000; return HWC2_ERROR_NONE;
	default: return HWC2_ERROR_BAD_PARAMETER;
	}
}

static int32_t z1_get_display_configs(hwc2_device_t *d, hwc2_display_t display,
				      uint32_t *num_configs, hwc2_config_t *configs)
