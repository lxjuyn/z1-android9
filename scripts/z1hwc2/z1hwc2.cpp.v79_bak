}

static int32_t z1_set_layer_blend_mode(hwc2_device_t *d, hwc2_display_t display,
				       hwc2_layer_t layer, int32_t mode)
{
	(void)d; (void)display; (void)layer; (void)mode;
	return HWC2_ERROR_NONE;
}

