/*
 * z1hwc2 — a minimal HWC2 composer for the Z1 (MT6572 mediatek-drm).
 *
 * Why this exists instead of AOSP's external/drm_hwcomposer: the android-9
 * tag's libs/ui and libs/nativewindow header trees disagree about where
 * ANativeWindowBuffer is defined, so that code base cannot be built outside
 * an AOSP tree without hand-writing libui's ABI.  This implementation needs
 * only <hardware/hwcomposer2.h>, the gralloc handle, and libdrm.
 *
 * Composition policy: up to four layers are handed to the OVL planes
 * (HWC2_COMPOSITION_DEVICE) when they are unrotated, unscaled, single-plane
 * and use a format the OVL supports; everything else is marked CLIENT and
 * SurfaceFlinger composites it into the client target, which takes the
 * bottom plane.
 */
#include <errno.h>
#include <stdarg.h>
#include <fcntl.h>
#include <inttypes.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

#include <map>
#include <vector>

#include <hardware/hardware.h>
#include <hardware/hwcomposer2.h>
#include <hardware/hwcomposer_defs.h>

#include <xf86drm.h>
#include <xf86drmMode.h>
#include <drm_fourcc.h>

#include <sys/system_properties.h>

#define LOG_TAG "z1hwc2"
#include <log/log.h>

static void klog(const char *fmt, ...)
{
	static int fd = -2;
	char buf[512];
	va_list ap;
	int n;

	if (fd == -2)
		fd = open("/dev/kmsg", O_WRONLY | O_CLOEXEC);
	if (fd < 0)
		return;
	va_start(ap, fmt);
	n = vsnprintf(buf, sizeof(buf), fmt, ap);
	va_end(ap);
	if (n > 0)
		(void)write(fd, buf, (size_t)n);
}

#define MAX_PLANES 4
#define MAX_LAYERS 16

/* ------- gralloc handle (matches z1a9_gpt/graphics/gralloc/gralloc_priv.h) --- */
struct z1_handle {
	int version;
	int numFds;
	int numInts;
	int fd;
	int magic;
	int flags;
	int size;
	int offset;
	uint64_t base __attribute__((aligned(8)));
	int pid;
	int width;
	int height;
	int stride;	/* pixels */
	int format;	/* HAL_PIXEL_FORMAT_* */
	int reserved;
};

#define Z1_HANDLE_MAGIC 0x3141592

static int hal_bpp(int fmt)
{
	switch (fmt) {
	case 1:  /* RGBA_8888 */
	case 2:  /* RGBX_8888 */
	case 5:  /* BGRA_8888 */
		return 4;
	case 3:  /* RGB_888 */
		return 3;
	case 4:  /* RGB_565 */
		return 2;
	default:
		return 0;
	}
}

static uint32_t hal_to_drm(int fmt)
{
	switch (fmt) {
	case 1: return DRM_FORMAT_ABGR8888;	/* RGBA_8888 */
	case 2: return DRM_FORMAT_XBGR8888;	/* RGBX_8888 */
	case 3: return DRM_FORMAT_BGR888;	/* RGB_888  */
	case 4: return DRM_FORMAT_BGR565;	/* RGB_565  */
	case 5: return DRM_FORMAT_ARGB8888;	/* BGRA_8888 */
	default: return 0;
	}
}

struct z1_layer {
	hwc2_layer_t id = 0;
	buffer_handle_t handle = nullptr;
	int acquire_fence = -1;

	hwc2_composition_t composition = HWC2_COMPOSITION_INVALID;
	hwc_rect_t frame = {};
	hwc_frect_t crop = {};
	float alpha = 1.0f;
	hwc_region_t visible = {};
	hwc_region_t damage = {};
	hwc_transform_t transform = (hwc_transform_t)0;
	int32_t z = 0;

	bool have_buffer = false;
	int fd = -1;
	uint32_t width = 0, height = 0, stride_bytes = 0, format_hal = 0;
	uint32_t drm_format = 0;
	uint32_t gem = 0, fb_id = 0;
};

struct z1_plane {
	uint32_t id = 0;
	bool in_use = false;
	uint32_t fb_id = 0;

	uint32_t p_fb = 0, p_crtc = 0, p_cx = 0, p_cy = 0, p_cw = 0, p_ch = 0;
	uint32_t p_sx = 0, p_sy = 0, p_sw = 0, p_sh = 0;
	uint32_t p_zpos = 0;
};

struct z1_hwc2 : public hwc2_device_t {
	hwc2_callback_data_t cb_data = nullptr;
	hwc2_function_pointer_t cb_hotplug = nullptr;
	hwc2_function_pointer_t cb_vsync = nullptr;
	hwc2_function_pointer_t cb_refresh = nullptr;

	std::map<hwc2_layer_t, z1_layer> layers;
	hwc2_layer_t next_layer_id = 1;

	buffer_handle_t client_target = nullptr;
	int client_acquire_fence = -1;
	uint32_t client_width = 0, client_height = 0;

	bool validated = false;
	std::vector<hwc2_layer_t> changed;

	/* DRM */
	int drm_fd = -1;
	uint32_t crtc_id = 0;
	uint32_t connector_id = 0;
	drmModeModeInfo mode = {};
	uint32_t width = 240, height = 320;
	z1_plane planes[MAX_PLANES];
	int plane_count = 0;
	uint32_t connector_crtc_prop = 0;
	uint32_t crtc_mode_prop = 0;
	uint32_t crtc_active_prop = 0;
	uint32_t mode_blob = 0;
	uint32_t client_fb = 0, client_gem = 0;
	buffer_handle_t client_handle = nullptr;
	bool mode_set_done = false;
	bool powered_on = true;
	bool vsync_enabled = false;

	std::vector<int> retire_fences;
	std::map<hwc2_layer_t, int> release_fences;
};

/* ------------------------------------------------------------------ DRM --- */

static uint32_t prop_id(int fd, uint32_t obj, uint32_t type, const char *name)
{
	drmModeObjectProperties *props = drmModeObjectGetProperties(fd, obj, type);
	uint32_t id = 0;

	if (!props)
		return 0;
	for (uint32_t i = 0; i < props->count_props; i++) {
		drmModePropertyRes *p = drmModeGetProperty(fd, props->props[i]);
		if (!p)
			continue;
		if (!strcmp(p->name, name))
			id = p->prop_id;
		drmModeFreeProperty(p);
		if (id)
			break;
	}
	drmModeFreeObjectProperties(props);
	return id;
}

static int drm_open(z1_hwc2 *h)
{
	const char *path = "/dev/dri/card1";
	char prop[PROP_VALUE_MAX] = {};

	/* hwc.drm.device overrides; on this board card0 is lima (render only) */
	__system_property_get("hwc.drm.device", prop);
	if (prop[0])
		path = prop;

	/*
	 * mediatek-drm is a component master: /dev/dri/card1 only appears once
	 * OVL/RDMA/DSI have all probed (~33 s on this board), while the composer
	 * service starts at ~24 s.  Wait for the node instead of failing.
	 */
	for (int i = 0; i < 60; i++) {
		h->drm_fd = open(path, O_RDWR | O_CLOEXEC);
		if (h->drm_fd >= 0)
			break;
		if (errno != ENOENT)
			break;
		if (!(i % 10))
			klog("z1hwc2: waiting for %s (%ds)\n", path, i / 2);
		usleep(500000);
	}
	if (h->drm_fd < 0) {
		klog("z1hwc2: cannot open %s: %s\n", path, strerror(errno));
		return -1;
	}
	klog("z1hwc2: opened %s fd=%d\n", path, h->drm_fd);
	if (drmSetClientCap(h->drm_fd, DRM_CLIENT_CAP_UNIVERSAL_PLANES, 1) ||
	    drmSetClientCap(h->drm_fd, DRM_CLIENT_CAP_ATOMIC, 1)) {
		klog("z1hwc2: %s has no atomic modesetting\n", path);
		return -1;
	}

	drmModeRes *res = drmModeGetResources(h->drm_fd);
	if (!res) {
		klog("z1hwc2: drmModeGetResources failed: %s\n", strerror(errno));
		return -1;
	}
	klog("z1hwc2: resources crtcs=%d encoders=%d connectors=%d\n",
	     res->count_crtcs, res->count_encoders, res->count_connectors);

	/* first connected connector */
	for (int i = 0; i < res->count_connectors; i++) {
		drmModeConnector *c = drmModeGetConnector(h->drm_fd, res->connectors[i]);
		if (!c)
			continue;
		if (c->connection == DRM_MODE_CONNECTED && c->count_modes) {
			h->connector_id = c->connector_id;
			h->mode = c->modes[0];
			h->width = h->mode.hdisplay;
			h->height = h->mode.vdisplay;
			break;
		}
		drmModeFreeConnector(c);
	}
	if (!h->connector_id || !res->count_crtcs) {
		klog("z1hwc2: no connected connector / crtc\n");
		drmModeFreeResources(res);
		return -1;
	}
	h->crtc_id = res->crtcs[0];

	h->connector_crtc_prop = prop_id(h->drm_fd, h->connector_id,
					  DRM_MODE_OBJECT_CONNECTOR, "CRTC_ID");
	h->crtc_mode_prop = prop_id(h->drm_fd, h->crtc_id, DRM_MODE_OBJECT_CRTC, "MODE");
	h->crtc_active_prop = prop_id(h->drm_fd, h->crtc_id, DRM_MODE_OBJECT_CRTC, "ACTIVE");

	drmModePlaneRes *pres = drmModeGetPlaneResources(h->drm_fd);
	if (pres) {
		for (uint32_t i = 0; i < pres->count_planes && h->plane_count < MAX_PLANES; i++) {
			drmModePlane *p = drmModeGetPlane(h->drm_fd, pres->planes[i]);
			if (!p)
				continue;
			if (!(p->possible_crtcs & 1)) {	/* must be able to drive crtc0 */
				drmModeFreePlane(p);
				continue;
			}
			z1_plane *pl = &h->planes[h->plane_count];
			pl->id = p->plane_id;
			pl->p_fb = prop_id(h->drm_fd, pl->id, DRM_MODE_OBJECT_PLANE, "FB_ID");
			pl->p_crtc = prop_id(h->drm_fd, pl->id, DRM_MODE_OBJECT_PLANE, "CRTC_ID");
			pl->p_cx = prop_id(h->drm_fd, pl->id, DRM_MODE_OBJECT_PLANE, "CRTC_X");
			pl->p_cy = prop_id(h->drm_fd, pl->id, DRM_MODE_OBJECT_PLANE, "CRTC_Y");
			pl->p_cw = prop_id(h->drm_fd, pl->id, DRM_MODE_OBJECT_PLANE, "CRTC_W");
			pl->p_ch = prop_id(h->drm_fd, pl->id, DRM_MODE_OBJECT_PLANE, "CRTC_H");
			pl->p_sx = prop_id(h->drm_fd, pl->id, DRM_MODE_OBJECT_PLANE, "SRC_X");
			pl->p_sy = prop_id(h->drm_fd, pl->id, DRM_MODE_OBJECT_PLANE, "SRC_Y");
			pl->p_sw = prop_id(h->drm_fd, pl->id, DRM_MODE_OBJECT_PLANE, "SRC_W");
			pl->p_sh = prop_id(h->drm_fd, pl->id, DRM_MODE_OBJECT_PLANE, "SRC_H");
			pl->p_zpos = prop_id(h->drm_fd, pl->id, DRM_MODE_OBJECT_PLANE, "zpos");
			h->plane_count++;
			drmModeFreePlane(p);
		}
		drmModeFreePlaneResources(pres);
	}
	drmModeFreeResources(res);

	/* 内核 zpos 是 immutable：必须按它升序排列，否则图层上下颠倒 */
	{
		int zpos[MAX_PLANES] = {0};

		for (int i = 0; i < h->plane_count; i++) {
			drmModeObjectProperties *props =
				drmModeObjectGetProperties(h->drm_fd, h->planes[i].id,
							   DRM_MODE_OBJECT_PLANE);
			zpos[i] = i;
			if (!props)
				continue;
			for (uint32_t k = 0; k < props->count_props; k++) {
				drmModePropertyRes *pr =
					drmModeGetProperty(h->drm_fd, props->props[k]);
				if (pr && !strcmp(pr->name, "zpos"))
					zpos[i] = (int)props->prop_values[k];
				if (pr)
					drmModeFreeProperty(pr);
			}
			drmModeFreeObjectProperties(props);
		}
		for (int i = 0; i + 1 < h->plane_count; i++)
			for (int j = 0; j + 1 < h->plane_count - i; j++)
				if (zpos[j] > zpos[j + 1]) {
					int t = zpos[j];
					z1_plane tp = h->planes[j];

					zpos[j] = zpos[j + 1];
					zpos[j + 1] = t;
					h->planes[j] = h->planes[j + 1];
					h->planes[j + 1] = tp;
				}
	}

	klog("z1hwc2: drm %s crtc=%u connector=%u %ux%u planes=%d\n", path,
	     h->crtc_id, h->connector_id, h->width, h->height, h->plane_count);

	if (!h->connector_crtc_prop || !h->crtc_mode_prop || !h->crtc_active_prop) {
		klog("z1hwc2: missing crtc/connector properties (conn_crtc=%u mode=%u active=%u)\n",
		     h->connector_crtc_prop, h->crtc_mode_prop, h->crtc_active_prop);
		return -1;
	}
	for (int i = 0; i < h->plane_count; i++) {
		z1_plane *pl = &h->planes[i];

		if (!pl->p_fb || !pl->p_crtc || !pl->p_cx || !pl->p_cy ||
		    !pl->p_cw || !pl->p_ch || !pl->p_sw || !pl->p_sh) {
			klog("z1hwc2: plane %u missing properties (fb=%u crtc=%u cw=%u sw=%u)\n",
			     pl->id, pl->p_fb, pl->p_crtc, pl->p_cw, pl->p_sw);
			return -1;
		}
	}
	return 0;
}

static int import_layer(z1_hwc2 *h, z1_layer *l)
{
	if (l->fb_id)
		return 0;

	struct z1_handle *gh = (struct z1_handle *)l->handle;
	uint32_t gem = 0;
	static bool logged_once;

	if (!logged_once) {
		logged_once = true;
		ALOGI("handle: ver=%d numFds=%d numInts=%d fd=%d magic=%#x flags=%#x "
		      "size=%d off=%d pid=%d w=%d h=%d stride=%d fmt=%d",
		      gh->version, gh->numFds, gh->numInts, gh->fd, gh->magic,
		      gh->flags, gh->size, gh->offset, gh->pid, gh->width,
		      gh->height, gh->stride, gh->format);
	}

	if (gh->magic != Z1_HANDLE_MAGIC)
		ALOGW("unexpected gralloc magic %#x (fd=%d w=%d h=%d stride=%d fmt=%d)",
		      gh->magic, gh->fd, gh->width, gh->height, gh->stride, gh->format);

	if (gh->width <= 0 || gh->height <= 0 || gh->width > 4096 ||
	    gh->height > 4096 || gh->stride <= 0 || gh->stride > 8192 ||
	    gh->fd < 0) {
		klog("z1hwc2: refusing handle: fd=%d %dx%d stride=%d fmt=%d\n",
		     gh->fd, gh->width, gh->height, gh->stride, gh->format);
		return -EINVAL;
	}

	int bpp = hal_bpp(gh->format);
	uint32_t fourcc = hal_to_drm(gh->format);
	if (!bpp || !fourcc)
		return -EINVAL;

	if (drmPrimeFDToHandle(h->drm_fd, gh->fd, &gem)) {
		ALOGE("drmPrimeFDToHandle(%d) failed: %s", gh->fd, strerror(errno));
		return -errno;
	}

	uint32_t pitches[4] = { (uint32_t)gh->stride * (uint32_t)bpp, 0, 0, 0 };
	uint32_t handles[4] = { gem, 0, 0, 0 };
	uint32_t offsets[4] = { 0, 0, 0, 0 };
	uint32_t fb = 0;

	if (drmModeAddFB2(h->drm_fd, gh->width, gh->height, fourcc, handles,
			  pitches, offsets, &fb, 0)) {
		ALOGE("drmModeAddFB2 failed: %s", strerror(errno));
		drmCloseBufferHandle(h->drm_fd, gem);
		return -errno;
	}

	l->fd = gh->fd;
	l->width = gh->width;
	l->height = gh->height;
	l->stride_bytes = pitches[0];
	l->format_hal = gh->format;
	l->drm_format = fourcc;
	l->gem = gem;
	l->fb_id = fb;
	return 0;
}

/* -------------------------------------------------------------- helpers --- */

static inline z1_hwc2 *H(hwc2_device_t *d) { return static_cast<z1_hwc2 *>(d); }

static int32_t find_free_plane(z1_hwc2 *h)
{
	for (int i = 0; i < h->plane_count; i++)
		if (!h->planes[i].in_use)
			return i;
	return -1;
}

static void clear_planes(z1_hwc2 *h)
{
	for (int i = 0; i < h->plane_count; i++)
		h->planes[i].in_use = false;
}

/* ------------------------------------------------------------ HWC2 core --- */

static void z1_get_capabilities(hwc2_device_t *d, uint32_t *count, int32_t *caps)
{
	(void)d;
	if (caps) {
		caps[0] = HWC2_CAPABILITY_SKIP_VALIDATE;
		caps[1] = HWC2_CAPABILITY_SKIP_CLIENT_COLOR_TRANSFORM;
	}
	*count = 2;
}

static void z1_register_callback(hwc2_device_t *d, int32_t descriptor,
				 hwc2_callback_data_t data, hwc2_function_pointer_t fn)
{
	z1_hwc2 *h = H(d);

	switch (descriptor) {
	case HWC2_CALLBACK_HOTPLUG: h->cb_hotplug = fn; break;
	case HWC2_CALLBACK_REFRESH: h->cb_refresh = fn; break;
	case HWC2_CALLBACK_VSYNC:   h->cb_vsync = fn; break;
	default: break;
	}
	h->cb_data = data;

	if (descriptor == HWC2_CALLBACK_HOTPLUG && fn) {
		typedef void (*hotplug_cb)(hwc2_callback_data_t, hwc2_display_t, int32_t);
		((hotplug_cb)fn)(data, HWC_DISPLAY_PRIMARY, h->connector_id ? 1 : 0);
	}
}

static int32_t z1_create_layer(hwc2_device_t *d, hwc2_display_t display,
			       uint32_t *out_layer)
{
	z1_hwc2 *h = H(d);

	if (display != HWC_DISPLAY_PRIMARY || h->layers.size() >= MAX_LAYERS)
		return HWC2_ERROR_NO_RESOURCES;

	hwc2_layer_t id = h->next_layer_id++;
	z1_layer l;
	l.id = id;
	l.composition = HWC2_COMPOSITION_INVALID;
	h->layers[id] = l;
	*out_layer = id;
	return HWC2_ERROR_NONE;
}

static int32_t z1_destroy_layer(hwc2_device_t *d, hwc2_display_t display,
				hwc2_layer_t layer)
{
	z1_hwc2 *h = H(d);
	auto it = h->layers.find(layer);

	if (it == h->layers.end())
		return HWC2_ERROR_BAD_LAYER;
	if (it->second.fb_id) {
		drmModeRmFB(h->drm_fd, it->second.fb_id);
		drmCloseBufferHandle(h->drm_fd, it->second.gem);
	}
	h->layers.erase(it);
	return HWC2_ERROR_NONE;
}

static int32_t z1_set_layer_buffer(hwc2_device_t *d, hwc2_display_t display,
				   hwc2_layer_t layer, buffer_handle_t buffer,
				   int32_t acquire_fence)
{
	z1_hwc2 *h = H(d);
	auto it = h->layers.find(layer);

	(void)display;
	if (it == h->layers.end())
		return HWC2_ERROR_BAD_LAYER;

	z1_layer *l = &it->second;
	if (buffer != l->handle) {
		if (l->fb_id) {
			drmModeRmFB(h->drm_fd, l->fb_id);
			drmCloseBufferHandle(h->drm_fd, l->gem);
			l->fb_id = 0;
			l->gem = 0;
		}
		l->handle = buffer;
	}
	l->acquire_fence = acquire_fence;
	l->have_buffer = buffer != nullptr;
	return HWC2_ERROR_NONE;
}

static int32_t z1_set_layer_composition_type(hwc2_device_t *d, hwc2_display_t display,
					     hwc2_layer_t layer, int32_t type)
{
	z1_hwc2 *h = H(d);
	auto it = h->layers.find(layer);

	(void)display;
	if (it == h->layers.end())
		return HWC2_ERROR_BAD_LAYER;
	it->second.composition = (hwc2_composition_t)type;
	return HWC2_ERROR_NONE;
}

static int32_t z1_set_layer_display_frame(hwc2_device_t *d, hwc2_display_t display,
					  hwc2_layer_t layer, hwc_rect_t frame)
{
	z1_hwc2 *h = H(d);
	auto it = h->layers.find(layer);

	(void)display;
	if (it == h->layers.end())
		return HWC2_ERROR_BAD_LAYER;
	it->second.frame = frame;
	return HWC2_ERROR_NONE;
}

