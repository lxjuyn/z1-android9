
# Z1 GPS: MTK mnld userspace daemon. It talks to the modem/GPS transport over
# /dev/stpgps and serves the legacy GPS HAL (vendor/lib/hw/gps.default.so),
# which the A9 gnss@1.0 HIDL impl loads through hw_get_module("gps").
# Started only after the radio transport is up, and it self-exits if the
# device node never appears.
service z1_mnld /vendor/bin/mnld
    class main
    user system
    group system inet media net_bt
    socket mnld stream 0660 system system
    disabled
    seclabel u:r:su:s0

on property:sys.z1.radio.modules_ready=1
    exec_background u:r:init:s0 root root -- /system/bin/sh /z1_gps_prep.sh
