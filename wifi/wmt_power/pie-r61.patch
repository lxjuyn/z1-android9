+constexpr char kWmtWifi[] = "/dev/wmtWifi";
+constexpr char kInterface[] = "wlan0";
+std::mutex wmt_lock;
+bool wmt_powered = false;
+
+bool wmt_set_power(char state) {
+  int fd = TEMP_FAILURE_RETRY(open(kWmtWifi, O_WRONLY | O_CLOEXEC | O_NOFOLLOW));
+  if (fd < 0) {
+    PLOG(ERROR) << "Failed to open WMT Wi-Fi control";
+    return false;
+  }
+  struct stat st;
+  bool success = false;
+  if (fstat(fd, &st) != 0 || !S_ISCHR(st.st_mode) ||
+      major(st.st_rdev) != 155 || minor(st.st_rdev) != 0) {
+    LOG(ERROR) << "Unexpected WMT Wi-Fi control node";
+  } else if (TEMP_FAILURE_RETRY(write(fd, &state, 1)) == 1) {
+    success = true;
+  } else {
+    PLOG(ERROR) << "Failed to switch WMT Wi-Fi power to " << state;
+  }
+  close(fd);
+  return success;
+}
+
+bool wmt_is_ready() {
+  char value[PROPERTY_VALUE_MAX];
+  return property_get("sys.z1.radio.wifi_modules_ready", value, "") &&
+         strcmp(value, "1") == 0 &&
+         property_get("init.svc.z1_6620", value, "") && strcmp(value, "running") == 0;
+}
+
+bool wmt_wait_until(bool (*ready)()) {
+  for (int retry = 0; retry < 50; ++retry) {
+    if (ready()) {
+      return true;
+    }
+    usleep(100000);
+  }
+  return ready();
+}
+
+bool wmt_has_interface() {
+  return if_nametoindex(kInterface) != 0;
+}
+bool wmt_interface_removed() {
+  return !wmt_has_interface();
+}
+
+bool wmt_power_off() {
+  if (wmt_powered || wmt_has_interface()) {
+    if (!wmt_set_power('0') || !wmt_wait_until(wmt_interface_removed)) {
+      LOG(ERROR) << "Wi-Fi did not reach powered-off state";
+      return false;
+    }
+  }
+  wmt_powered = false;
+  return property_set(DRIVER_PROP_NAME, "unloaded") == 0;
+}
