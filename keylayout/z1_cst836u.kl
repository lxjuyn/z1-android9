# Z1 touchscreen navigation strip, separate from physical repeat/follow keys.
# Preserve the BACK/HOME/APP_SWITCH actions present in system_v35.img.
# Driver z1_cst836u.c:136-138 emits Linux EV_KEY 158/102/139.
# Physical strip operation still requires on-device verification.
# Android 9 rejects the legacy WAKE and WAKE_DROPPED flags.
key 158   BACK
key 102   HOME
key 139   APP_SWITCH
