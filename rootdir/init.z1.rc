# Imported by Pie init when DT bootargs sets androidboot.hardware=z1.
# No vendor services are started until their HALs and kernel interfaces pass.

import /init.z1.network.rc

on fs
    mount_all /fstab.z1

# The LK leaves MT6572's hardware watchdog enabled. Start feeding it as soon
# as ueventd can create /dev/watchdog, before the full boot class starts.
on init
    start watchdogd

# Persistent properties are loaded after the early boot actions. Replace any
# prior ADB default before Android's USB framework observes the disabled
# generic USB mode. The final ramdisk injector also removes generic USB gadget
# rc imports; the independent diagnostic helper owns ACM directly through
# configfs.
on property:ro.persistent_properties.ready=true
    setprop persist.sys.usb.config none
    setprop sys.usb.config none

service watchdogd /sbin/watchdogd 5 10
    class core
    user root
    group root
    seclabel u:r:watchdogd:s0

# Pie fs_mgr configures zram0 and invokes the built-in mkswap/swapon tools.
on post-fs-data
    swapon_all /fstab.z1
    # /system is mounted on fs; init starts the core/main classes on boot.
    # Synchronously switch the VT and detach fbcon before SurfaceFlinger starts.
    # Only the framebuffer console is detached; the serial console remains active.
    exec u:r:init:s0 root root -- /system/bin/sh /z1_display_takeover.sh
