# Factory MTK NVRAM daemon, registered for dependency diagnostics only.
# Starting it can create or reset calibration files below /data/nvram.
# Keep disabled: no automatic start and no calibration-ready property mapping.
service nvram_daemon /system/bin/nvram_daemon
    class main
    user nvram
    group nvram system
    oneshot
    disabled
    seclabel u:r:init:s0
